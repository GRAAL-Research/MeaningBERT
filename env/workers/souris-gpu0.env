# TITAN Xp, 12 Go, mais 18 Go de disque libre apres le menage : plus de place pour
# deberta-v3-large. Elle prend les deux architectures de taille base, dont le d_full de
# nli, et ne garde qu'un point de controle intermediaire pour ne pas remplir la partition
# une seconde fois.
GPU=0
SLICES="nli-deberta-v3-base|d_full;stsb-roberta-base|c_none c_full d_none"
HEADS=clamped
NUM_WORKERS=6
SAVE_TOTAL_LIMIT=1
