# GTX 1080 Ti. Reentrainement des cellules finalistes avec sauvegarde des poids.
# Les graines 43 a 51 ont deja tourne, mais sans conserver leurs poids : le balayage ne
# gardait que la graine de reference, pour tenir dans le disque de souris. Sans poids, le
# nouveau protocole d'evaluation, suites a couverture complete et symetrie, n'est
# mesurable que sur une graine, donc sans dispersion. On refait les memes runs, memes
# graines, meme code : les metriques seront identiques, seuls les poids s'ajoutent.
# d_none passe en premier : c'est le modele que l'article publie.
GPU=0
SLICES="deberta-v3-large|d_none|43 44 45 46 47;deberta-v3-large|d_full|43 44 45 46 47"
HEADS=clamped
NUM_WORKERS=4
KEEP_SWEEP_MODELS=true
