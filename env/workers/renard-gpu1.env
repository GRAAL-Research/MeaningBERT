# Quadro P5000, 16 Go, sur un disque de 370 Go libres : la seule carte qui peut encore
# accueillir deberta-v3-large, dont chaque point de controle pese 5 Go. Puis le run le plus
# lourd de roberta-base, parce que cette carte n'a rien d'autre a faire.
GPU=1
SLICES="deberta-v3-large|d_none;stsb-roberta-base|d_full"
HEADS=clamped
NUM_WORKERS=4
