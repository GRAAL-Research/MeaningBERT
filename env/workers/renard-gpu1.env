# Quadro P5000. Cinq des neuf graines manquantes de bert-base-uncased sur d_full.
#
# Le rang d de bert ne va PAS sur le GTX 1080 Ti : il y a fige trois fois sur trois, avec
# et sans chargeurs de donnees, alors que les autres architectures y passent. La graine 42
# de cette meme cellule est passee ici en 87 minutes.
#
# Poids conserves : sans eux, la cellule ne peut pas etre lue sous le protocole complet,
# suites a couverture totale et mesure de symetrie, et c'est justement ce qui manque pour
# publier le point de controle rapide avec une dispersion.
GPU=1
SLICES="bert|d_full|43 44 45 46"
HEADS=clamped
NUM_WORKERS=4
KEEP_SWEEP_MODELS=true
