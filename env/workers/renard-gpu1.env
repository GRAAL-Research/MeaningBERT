# Quadro P5000, 16 Go : la seule carte qui tient deberta-v3-large a micro-lot 8 sur le
# rang d. Elle finit la grille a une graine, puis prend quatre des neuf graines du run le
# plus cher du parc, large/d_full, qui vaut 406 minutes piece.
GPU=1
SLICES="bert|d_none|42;nli-deberta-v3-base|c_none c_full d_none|42;deberta-v3-large|d_full|43 44 45 46"
HEADS=clamped
NUM_WORKERS=4
